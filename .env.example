# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Origin of the React app (used for CORS allowlist and links in emails)
CLIENT_URL=http://localhost:5173

# ---------- Database (PostgreSQL; Neon in production) ----------
DATABASE_URL=postgresql://borrowbox:borrowbox@localhost:5432/borrowbox
# Used only by `npm run test:integration` (must be a DIFFERENT database)
TEST_DATABASE_URL=postgresql://borrowbox:borrowbox@localhost:5432/borrowbox_test

# ---------- Security ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CSRF_SECRET=replace-with-another-long-random-secret-at-least-32-chars

# ---------- Email (SMTP). Leave blank in dev to log emails to the console ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BorrowBox <no-reply@borrowbox.example>"

# ---------- Images (Cloudinary). Leave blank to disable uploads (graceful state) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dev-only escape hatch: set to "local" to store uploads on disk in server/uploads
STORAGE_PROVIDER=cloudinary

# ---------- Optional admin bootstrap (development) ----------
# Used by `npm run db:seed` to create the admin user. Never set a real value in git.
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!

# ---------- Client (PUBLIC — bundled into the frontend) ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---------- Deployment / cross-origin ----------
# Public origin of THIS API (used to build absolute image URLs when STORAGE_PROVIDER=local)
PUBLIC_API_URL=http://localhost:4000
# lax (default) works when the client proxies /api (Vercel rewrite). Use "none" only for cross-site setups (requires HTTPS).
COOKIE_SAMESITE=lax
# Never enable in production. Exposes an in-memory email outbox for automated tests.
ENABLE_TEST_ENDPOINTS=false
# Optional contact email shown on the Help page (client, public)
VITE_SUPPORT_EMAIL=
